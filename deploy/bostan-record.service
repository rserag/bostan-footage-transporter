[Unit]
Description=Local camera recording
Wants=network-online.target systemd-timesyncd.service
# The recorder implements its own bounded synchronization wait. Do not order it
# after time-sync.target: an enabled infinite wait service could block capture.
After=network-online.target systemd-timesyncd.service
StartLimitIntervalSec=0
[Service]
User=bostan
Group=bostan
ExecStart=/usr/bin/python3 /opt/bostan/bostan.py record --config /etc/bostan/pi.json
LoadCredential=camera.env:/etc/camera-recorder/camera.env
Restart=always
RestartSec=10
TimeoutStopSec=180
KillMode=control-group
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bostan
MemoryMax=160M
[Install]
WantedBy=multi-user.target
